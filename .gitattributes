*.bat text eol=crlf
gradlew text eol=lf
*.sh text eol=lf

# Large generated tables (race tablebase etc.) are stored with Git LFS
tablebase/tables/*.bin filter=lfs diff=lfs merge=lfs -text
# the zstd archive of rows1.bin (plan section 3.8); rows1.bin itself is never committed (see .gitignore)
tablebase/tables/*.zst filter=lfs diff=lfs merge=lfs -text
# every trained network (F32 safetensors, gzip -9), written by scripts/models/archive-nets.py (models/README.md)
models/nets/**/*.safetensors.gz filter=lfs diff=lfs merge=lfs -text
