    { "id": "endpoint", "label": "Endpoint GameEndpoint", "runsIn": "Spring MVC request thread", "source": { "paths": ["app/src/main/java/sternhalma/app/GameEndpoint.java"] } },
    { "id": "engines", "label": "Engine service and semaphore", "runsIn": "request thread", "source": { "paths": ["app/src/main/java/sternhalma/app/Engines.java"] } },
    { "id": "alphaBeta", "label": "Alpha-beta players", "runsIn": "request thread", "source": { "paths": ["search/src/main/java/sternhalma/search/Strategies.java", "search/src/main/java/sternhalma/search/AlphaBeta.java", "search/src/main/java/sternhalma/search/AlphaBetaPlayer.java"] } },
    { "id": "raceTables", "label": "Race tables rows2 and rows1", "runsIn": "JVM heap", "source": { "paths": ["tablebase/src/main/java/sternhalma/tablebase/RaceTable.java", "tablebase/tables/"] } },
    { "id": "networkPlayer", "label": "Network player", "runsIn": "request thread", "source": { "paths": ["search/src/main/java/sternhalma/search/MctsPlayer.java"] } },
    { "id": "cpuForward", "label": "CPU forward pass", "runsIn": "request thread", "source": { "paths": ["nn/src/main/java/sternhalma/nn/VectorNetwork.java"] } },
    { "id": "gpuForward", "label": "GPU forward pass", "runsIn": "request thread", "source": { "paths": ["nn-tornado/src/main/java/sternhalma/tornado/TornadoNetwork.java"] } },
    { "id": "jarBuild", "label": "Build of the jar", "runsIn": "build", "source": { "paths": ["app/build.gradle.kts", "scripts/web/app-run.zsh"] } }
