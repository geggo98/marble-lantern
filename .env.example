# Copy to .env (gitignored) and fill in. Never commit real values.

# Prefer an AWS profile over raw keys. Used by scripts/cloud/aws-spot.sh (docs/cloud.md); names only, fill in your own.
# AWS_PROFILE=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# TornadoVM backend: metal | cuda | opencl (ptx is accepted as cuda). Selects the SDK flavour of scripts/setup-tornado.sh
# and the device at run time (docs/tornado.md, "Device selection"); TORNADO_DEVICE is the device index within the backend.
TORNADO_BACKEND=metal
# TORNADO_DEVICE=0
